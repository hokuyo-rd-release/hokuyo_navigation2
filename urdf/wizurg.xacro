<?xml version="1.0"?>
<!-- Revolute-Revolute Manipulator -->
<robot name="icart_mini" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Constants for robot dimensions -->
  <xacro:property name="PI" value="3.1415926535897931"/>
  <!-- Wizurg mesh - exported from Blender (Wizurg.blend), base_footprint origin = floor under drive axle.
       base_link is 0.068 m above the floor (drive axle 0.143 m - 0.075 m), so the mesh is shifted down. -->
  <xacro:property name="mesh_z" value="-0.068"/>

  <!-- Import Rviz colors -->
  <xacro:include filename="$(find hokuyo_navigation2)/urdf/materials.xacro" />
  <xacro:include filename="$(find hokuyo_navigation2)/urdf/wizurg.gazebo"/>

  <!-- Base Link -->
  <link name="base_link">
    <collision>
      <origin xyz="-0.17 0 0.1" rpy="0 0 0"/>
      <geometry>
	    <box size=".73 .58 .15"/>
      </geometry>
    </collision>

    <visual>
      <origin xyz="0 0 ${mesh_z}" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://hokuyo_navigation2/urdf/meshes/wizurg_visual.obj" scale="1 1 1"/>
      </geometry>
    </visual>

    <collision name="collision">
      <origin xyz="-0.325 0.0 0.05" rpy="0 ${PI*0.5} ${PI*0.5}"/>
      <geometry>
        <cylinder  length="0.03" radius="0.04625"/>
      </geometry>
    </collision>

    <inertial>
       <!-- total robot 70 kg = base 68 + wheels 1 + 1. Same CoM / inertia as the Unity WizURG prefab -
            CoM 0.30 m above the floor (batteries low in the base), between drive axle and casters;
            inertia of the body volume about the CoM (from the Wizurg model). -->
       <mass value="68" />
       <origin xyz="-0.170 0 0.232" rpy="0 0 0"/>
       <inertia ixx="4.4191" ixy="0" ixz="0" iyy="5.1824" iyz="0" izz="3.2912" />
    </inertial>
  </link>

  <link name="left_wheel">
    <collision name="collision">
      <origin xyz="0 0.0 0" rpy="0 ${PI*0.5} ${PI*0.5}"/>
      <geometry>
         <cylinder  length="0.03" radius="0.1397"/>
      </geometry>
    </collision>
    <visual name="visual">
      <origin xyz="0 0.0 0" rpy="0 ${PI*0.5} ${PI*0.5}"/>
      <geometry>
        <cylinder  length="0.03" radius="0.1397"/>
      </geometry>
    </visual>
    <inertial>
      <mass value="1" />
      <origin xyz="0 0.0 0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1" />
    </inertial>
  </link>

  <joint type="revolute" name="left_wheel_hinge">
    <origin xyz="0 0.198 0.075" rpy="0 0 0"/>
    <child link="left_wheel">left_wheel</child>
    <parent link="base_link">base_link</parent>
    <axis xyz="0 1 0"/>
    <limit effort="100" velocity="100.0"  lower="-5000" upper="5000" />
  </joint>

  <link name="right_wheel">
    <collision name="collision">
      <origin xyz="0 0.0 0" rpy="0 ${PI*0.5} ${PI*0.5}"/>
      <geometry>
         <cylinder  length="0.03" radius="0.1397"/>
      </geometry>
    </collision>
    <visual name="visual">
      <origin xyz="0 0.0 0" rpy="0 ${PI*0.5} ${PI*0.5}"/>
      <geometry>
        <cylinder  length="0.03" radius="0.1397"/>
      </geometry>
    </visual>
    <inertial>
      <mass value="1" />
      <origin xyz="0 0.0 0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1" />
    </inertial>
  </link>

  <joint type="revolute" name="right_wheel_hinge">
    <origin xyz="0 -0.198 0.075" rpy="0 0 0"/>
    <child link="right_wheel">right_wheel</child>
    <parent link="base_link">base_link</parent>
    <axis xyz="0 1 0"/>
    <limit effort="100" velocity="100.0"  lower="-5000" upper="5000" />
  </joint>


  <transmission name="tran1">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="left_wheel_hinge">
      <hardwareInterface>VelocityJointInterface</hardwareInterface>
    </joint>
    <actuator name="left_motor">
      <hardwareInterface>VelocityJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="tran2">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="right_wheel_hinge">
      <hardwareInterface>VelocityJointInterface</hardwareInterface>
    </joint>
    <actuator name="right_motor">
      <hardwareInterface>VelocityJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <joint name="base_scan_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_scan"/>
    <origin xyz="0.0 0.0 0.3" rpy="0 0 0"/>
  </joint>
  <link name="base_scan"/>

  <joint name="laser_joint1" type="fixed">
    <parent link="base_link"/>
    <child  link="ust"/>
    <origin xyz="0.002 0.2815 0.706" rpy="3.141592653589793 0 1.3"/>
  </joint>
  <link name="ust">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.02" length="0.06" />
      </geometry>
      <material name="red" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.06" />
      </geometry>
    </collision>
  </link> 
  
  <joint name="laser_joint2" type="fixed">
    <parent link="base_link"/>
    <child  link="ust2"/>
    <origin xyz="0.002 -0.2815 0.706" rpy="3.141592653589793 0 -1.3"/>
  </joint>
  <link name="ust2">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.02" length="0.06" />
      </geometry>
      <material name="red" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.06" />
      </geometry>
    </collision>
  </link>

  <joint name="laser_joint3" type="fixed">
    <parent link="base_link"/>
    <child  link="yvt"/>
    <!-- RSF-X001 frame (YVT window centre) -->
    <origin xyz="0.286 0 0.572" rpy="0 0 0"/>
  </joint>
  <link name="yvt">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.02" length="0.06" />
      </geometry>
      <material name="red" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.06" />
      </geometry>
    </collision>
  </link>

  <joint name="laser_joint4" type="fixed">
    <parent link="base_link"/>
    <child  link="ylm"/>
    <origin rpy="0 0 0" xyz="0.247 0 0.354"/>
  </joint>
  <link name="ylm">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.02" length="0.06" />
      </geometry>
      <material name="red" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.06" />
      </geometry>
    </collision>
  </link>


  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="camera"/>
    <origin xyz="0.10 -0.20 0.45" rpy="0 0 0"/>
  </joint>
  <link name="camera">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.02" length="0.06" />
      </geometry>
      <material name="red" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.06" />
      </geometry>
    </collision>
  </link>

  <joint name="gnss_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="gnss"/>
    <!-- top centre of the GNSS antenna on the head -->
    <origin xyz="-0.100 0.0 0.880" rpy="0 0 0"/>
  </joint>
  <link name="gnss">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.02" length="0.06" />
      </geometry>
      <material name="red" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.06" />
      </geometry>
    </collision>
  </link>
</robot>
