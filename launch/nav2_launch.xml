<?xml version='1.0' ?>

<launch>
  <arg name="use_sim_time" default="false"/>
  <arg name="namespace" default=""/>
  <arg name="params_file" default="$(find-pkg-share hokuyo_navigation2)/params/nav2_params.yaml"/>

  <include file="$(find-pkg-share lio_nav2_bringup)/launch/navigation_launch.xml">
    <arg name="namespace" value="$(var namespace)"/>
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="autostart" value="true"/>
    <arg name="params_file" value="$(var params_file)"/>
  </include>
</launch>