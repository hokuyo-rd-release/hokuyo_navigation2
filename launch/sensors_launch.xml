<?xml version='1.0' ?>
<launch>
  <!-- set connect param -->
  <arg name="gnss_com" default="/dev/GNSS_SERIAL" />
  <arg name="gnss_baud" default="38400" />
  <arg name="yvt_ip" default="192.168.0.12" />

  <!-- set frame name -->
  <arg name="frame_gnss" default="gnss" />
  <arg name="frame_yvt" default="yvt" />
  
  <!--以下はRSFノードに置き換わる-->
  <!-- gnss module -->
  <!---->
  <node pkg="nmea_navsat_driver" exec="nmea_serial_driver" name="nmea_serial_driver" >
    <param name="port" value="$(var gnss_com)" />
    <param name="baud" value="$(var gnss_baud)" />
    <param name="frame_id" value="$(var frame_gnss)" />
  </node>
  <!-- yvt module -->
  <!---->
	<node pkg="hokuyo3d_ros2" exec="hokuyo3d_node" name="hokuyo3d">
		<param name="ip_address" value="$(var yvt_ip)" />
		<param name="frame_id" value="$(var frame_yvt)" />
		<param name="horizontal_interlace" value ="4" />
    <param name="vertical_interlace" value ="2" />
	</node>
  <!---->

  <!--other sensors ex. uam module-->
  <!-- <include file="$(find-pkg-share hokuyo_navigation2)/launch/safety_urg_node2_2sensor.launch.py" /> -->
</launch>