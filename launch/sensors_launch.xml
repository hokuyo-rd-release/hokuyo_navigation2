    <param name="port" value="$(arg gnss_com)" />
    <param name="baud" value="$(arg gnss_baud)" />
    <param name="frame_id" value="$(arg frame_gnss)" />
  </node> -->
  <!---->

  <!-- ust module -->
  <!---->
  	<!----> 
  <node pkg="urg_node2" exec="urg_node2_node" name="ust1">
		<param name="ip_address" value="$(var ust_ip)" />
		<param name="frame_id" value="$(var frame_ust)" />
	       <param name="angle_min" value="-1.221730"/>
	       <param name="angle_max" value="1.91986"/>
		<remap from="/scan" to="/urg_node1/scan" />
	</node>
  <node pkg="urg_node2" exec="urg_node2_node" name="ust2">
		<param name="ip_address" value="$(var ust2_ip)" />
		<param name="frame_id" value="$(var frame_ust2)" />
	       <param name="angle_max" value="1.221730"/>
	       <param name="angle_min" value="-1.91986"/>
		<remap from="/scan" to="/urg_node2/scan" />
	</node>	 
  <!---->

  <!-- yvt module -->
  <!---->
	<node pkg="hokuyo3d_ros2" exec="hokuyo3d_node" name="hokuyo3d">
		<param name="ip_address" value="$(var yvt_ip)" />
		<param name="frame_id" value="$(var frame_yvt)" />
		<param name="horizontal_interlace" value ="4" />
    <param name="vertical_interlace" value ="2" />
    <!--param name="range_min" value ="0.5" /-->
	</node>
  <!---->

  <!-- ylm module -->
  <!---->
	<!----> 
  <node pkg="ylm_ros2" exec="lumotive_driver" name="lumotive_driver" output="screen">
    <param from="$(var ylm_config_path)" />
    <param name="sensor_ip" value="$(var ylm_ip)" />
    <param name="sensor_port" value="$(var ylm_sensor_port)" />
    <param name="device_frame_id" value="$(var frame_ylm)" />
  </node> 

  <!---->
  
   <!--ust convert-->
   <!---->
    <!-- <node pkg="ira_laser_tools" name="laserscan_multi_merger" exec="laserscan_multi_merger" output="screen">
        <param name="destination_frame" value="base_scan"/>
        <param name="cloud_destination_topic" value="/merged_cloud"/>
        <param name="scan_destination_topic" value="/scan"/>
        <param name="laserscan_topics" value ="/urg_node1/scan /urg_node2/scan" />
         
      	<param name="angle_min" value="-3.14159"/>
	<param name="angle_max" value="3.14159"/>
	      <param name="range_min" value="0.05"/>
	      <param name="range_max" value="30.0"/>
    </node> -->
    <!---->
  <node pkg="ira_laser_tools" exec="laserscan_multi_merger" name="merger_node" output="screen">
    <param name="destination_frame" value="base_link" />
    <param name="cloud_destination_topic" value="/merged_cloud" />
    <param name="scan_destination_topic" value="/merged_scan" />
    <param name="laserscan_topics" value="/urg_node1/scan /urg_node2/scan" />

    <param name="angle_min" value="-3.14159265359" />
    <param name="angle_max" value="3.14159265359" />
    <param name="range_min" value="0.05" />
    <param name="range_max" value="30.0" />
  </node>
</launch>