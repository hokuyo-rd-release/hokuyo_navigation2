<?xml version="1.0"?>
<launch>
  <arg name="map_name" default="map.pcd" description="Map name to save"/>
  <arg name="sub_topic" default="/hokuyo_lio/aligned_scan_points" description="Input point cloud topic"/>
  <arg name="sub_odom" default="/hokuyo_lio/lidar_odom" description="Input odometry topic"/>
  <arg name="pub_topic" default="/dummy/point_cloud" description="Output point cloud topic"/>
  <arg name="target_frame" default="dummy" description="Target frame for transform"/>
  <arg name="map_dir" default="$(find-pkg-share hokuyo_navigation2)/map" description="Directory to save map"/>
  <arg name="pc_save_distance" default="0.1" description="Distance threshold to save point cloud"/>

  <node pkg="hokuyo_navigation2" exec="pcd_tf_transform" name="pcd_tf_transform_node" output="screen">
    <param name="save_map" value="true" />
    <param name="sub_topic" value="$(var sub_topic)" />
    <param name="sub_odom_topic" value="$(var sub_odom)" />
    <param name="pub_topic" value="$(var pub_topic)" />
    <param name="target_frame" value="$(var target_frame)" />
    <param name="map_dir" value="$(var map_dir)" />
    <param name="map_name" value="$(var map_name)" />
    <param name="pc_save_distance" value="$(var pc_save_distance)" />
  </node>
</launch>