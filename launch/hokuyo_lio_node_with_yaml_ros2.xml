<?xml version='1.0' ?>
<!-- hokuyo_lio_node.launch -->
<launch >
  <arg name="launch_rviz" default="false" />
  <arg name="node_name" default="hokuyo_lio_node" />
  <arg name="lio_frame" default="base_link" />

  <node pkg="hokuyo_lio" exec="hokuyo_lio" name="$(var node_name)" output="screen" >
    <param from="$(find-pkg-share hokuyo_navigation2)/config/hokuyo_lio_params_ros2.yaml"/>
    <param name="lidar_frame" value="$(var lio_frame)"/>
  </node >
  <node pkg="rviz2" exec="rviz2" name="hlio_rviz" output="log" args="-d $(find-pkg-share hokuyo_lio)/config/hokuyo_lio_ros2.rviz" if="$(var launch_rviz)" />

</launch >
