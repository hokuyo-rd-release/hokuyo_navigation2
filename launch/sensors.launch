<?xml version="1.0"?>

<launch>

  <!-- <rosparam command="load" file="$(find wizurg)/params/move_base_params/use_sensor_params.yaml" > -->

  <!-- set connect param -->
  <arg name="camera_com" default="/dev/video0" />
  <arg name="gnss_com" default="/dev/ttyACM1" />
  <arg name="gnss_baud" default="38400" />
  <arg name="ust_ip" default="192.168.0.11" />
  <arg name="ust2_ip" default="192.168.0.13" /> 
  <arg name="yvt_ip" default="192.168.0.12" />
  <arg name="ylm_ip" default="192.168.0.10" />
  <arg name="ylm_sensor_port_" default="10940" doc="Lumotive sensor UDP port number"/>
  
  <!-- set frame name -->
  <arg name="frame_camera" default="camera" /> 
  <arg name="frame_gnss" default="gnss" />
  <arg name="frame_ust" default="ust" />
  <arg name="frame_ust2" default="ust2" />
  <arg name="frame_yvt" default="yvt" />
  <arg name="frame_ylm" default="ylm" />
  
  <!-- camera module -->
  <!---->
  <!-- <node pkg="usb_cam" type="usb_cam_node" name="usb_cam_node">
    <param name="video_device" value="$(arg camera_com)" />
    <param name="pixel_format" value="mjpeg" />
    <param name="frame_id" value="$(arg frame_camera)" />
  </node> -->
  <!---->
  
  <!-- gnss module -->
  <!---->
  <node pkg="nmea_navsat_driver" type="nmea_serial_driver" name="nmea_serial_driver" >
    <param name="port" value="$(arg gnss_com)" />
    <param name="baud" value="$(arg gnss_baud)" />
    <param name="frame_id" value="$(arg frame_gnss)" />
  </node>
  <!---->

  <!-- ust module -->
  <!---->
  	<node pkg="urg_node" type="urg_node" name="urg_node">
		<param name="ip_address" value="$(arg ust_ip)" />
		<param name="frame_id" value="$(arg frame_ust)" />
	       <param name="angle_min" value="-1.95"/>
	       <param name="angle_max" value="1.95"/>
		<remap from="/scan" to="/urg_node1/scan" />
	</node>
  	<node pkg="urg_node" type="urg_node" name="urg_node2">
		<param name="ip_address" value="$(arg ust2_ip)" />
		<param name="frame_id" value="$(arg frame_ust2)" />
	       <param name="angle_min" value="-1.208"/>
	       <param name="angle_max" value="1.208"/>
		<remap from="/scan" to="/urg_node2/scan" />
	</node>	
  <!---->

  <!-- yvt module -->
  <!---->
	<node pkg="hokuyo3d" type="hokuyo3d" name="hokuyo3d3">
		<param name="ip" value="$(arg yvt_ip)" />
		<param name="frame_id" value="$(arg frame_yvt)" />
		<param name="horizontal_interlace" value ="4" />
       <param name="vertical_interlace" value ="2" />
	</node>
  <!---->

  <!-- ylm module -->
  <!---->
	<node pkg="ylm_ros" name="lumotive_driver" type="lumotive_driver" output="screen">
		<rosparam command="load" file="$(find ylm_ros)/config/m20_configs.yaml"/>
		<param name="sensor_ip" type="str" value="$(arg ylm_ip)" />
		<param name="sensor_port" type="int" value="$(arg ylm_sensor_port_)" />
		<param name="device_frame_id" value="$(arg frame_ylm)" />
    </node>
  <!---->
  
   <!--ust convert-->
   <!---->
    <node pkg="ira_laser_tools" name="laserscan_multi_merger" type="laserscan_multi_merger" output="screen">
        <param name="destination_frame" value="base_scan"/>
        <param name="cloud_destination_topic" value="/merged_cloud"/>
        <param name="scan_destination_topic" value="/scan"/>
        <param name="laserscan_topics" value ="/urg_node1/scan /urg_node2/scan" />
         
	<param name="angle_min" value="-3.14159"/>
	<param name="angle_max" value="3.14159"/>
	<param name="range_min" value="0.05"/>
	<param name="range_max" value="30.0"/>
    </node>
    <!---->
</launch>
